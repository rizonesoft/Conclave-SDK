<?xml version="1.0"?>
<ruleset name="Conclave WordPress">
  <description>WordPress-Extra. Toolchain is tools/phpcs so the site composer.json stays clean.</description>
  <rule ref="WordPress-Extra"/>
  <file>.</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/tools/phpcs/*</exclude-pattern>
</ruleset>
