#!/usr/bin/env python3
"""Run this checkout's DDEV environment with fresh Docker group membership."""
import os
import grp
import shlex
import sys
from pathlib import Path
os.chdir(Path(__file__).resolve().parents[1])
if grp.getgrnam("docker").gr_gid in os.getgroups():
    os.execvp("ddev", ["ddev", *sys.argv[1:]])
os.execvp("sg", ["sg", "docker", "-c", shlex.join(["ddev", *sys.argv[1:]])])
