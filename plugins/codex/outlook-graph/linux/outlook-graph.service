[Unit]
Description=Rizonetech Outlook Graph private MCP tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=rizonetech-outlook-graph
StateDirectory=rizonetech-outlook-graph
StateDirectoryMode=0700
LoadCredentialEncrypted=cache-key:/etc/rizonetech-mcp/outlook-graph.cache-key.cred
LoadCredentialEncrypted=tunnel-key:/etc/rizonetech-mcp/tunnel-key.cred
EnvironmentFile=/etc/rizonetech-mcp/outlook-graph.conf
ExecStart=/opt/rizonetech-mcp/outlook-graph/run-tunnel.sh
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
