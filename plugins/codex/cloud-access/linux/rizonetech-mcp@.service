[Unit]
Description=Rizonetech private MCP tunnel (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
LoadCredentialEncrypted=provider:/etc/rizonetech-mcp/%i.provider.cred
LoadCredentialEncrypted=tunnel-key:/etc/rizonetech-mcp/tunnel-key.cred
ExecStart=/opt/rizonetech-mcp/run-tunnel.sh %i
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=512M
TasksMax=128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rizonetech-mcp-%i

[Install]
WantedBy=multi-user.target
